/* Basic styling */
body {
  font-family: Arial, sans-serif;
  margin: 0;
  padding: 0 1rem;
  background-color: #f9f9f9;
}

header {
  background-color: #004d99;
  color: white;
  padding: 1rem 0;
  text-align: center;
}

nav ul {
  list-style: none;
  padding: 0;
  display: flex;
  justify-content: center;
  gap: 1rem;
}

nav a {
  color: white;
  text-decoration: none;
  font-weight: bold;
}

nav a:hover {
  text-decoration: underline;
}

section {
  margin: 2rem 0;
}

.project {
  border: 1px solid #ddd;
  padding: 1rem;
  margin-bottom: 1rem;
  background-color: white;
}

.project img {
  max-width: 100%;
  height: auto;
}

/* Responsive layout */
@media (min-width: 600px) {
  .project {
    display: flex;
    gap: 1rem;
  }
  .project img {
    max-width: 200px;
  }
}

form {
  display: flex;
  flex-direction: column;
  max-width: 400px;
}

label {
  margin: 0.5rem 0 0.2rem;
}

input {
  padding: 0.4rem;
  font-size: 1rem;
  border: 1px solid #ccc;
  border-radius: 4px;
}

button {
  margin-top: 1rem;
  padding: 0.6rem;
  background-color: #004d99;
  color: white;
  font-size: 1rem;
  border: none;
  border-radius: 4px;
  cursor: pointer;
}

button:hover {
  background-color: #003366;
}
